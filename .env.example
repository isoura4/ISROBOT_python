# ============================================================================
# ISROBOT — Exemple de configuration
# ----------------------------------------------------------------------------
# Copiez ce fichier vers .env et renseignez vos valeurs.
# Les clés absentes de votre .env y seront ajoutées automatiquement au
# démarrage (voir ensure_env_variables() dans main.py).
# ============================================================================

# Plateforme: discord ou gamevox
PLATFORM=discord

# --- Configuration Discord ---------------------------------------------------
# ID de votre application Discord
app_id=YOUR_BOT_APPLICATION_ID
# Token secret de votre bot
secret_key=YOUR_BOT_TOKEN
# ID de votre serveur Discord
server_id=YOUR_DISCORD_SERVER_ID

# --- Configuration GameVox (requis si PLATFORM=gamevox) ----------------------
gamevox_bot_token=YOUR_GAMEVOX_BOT_TOKEN

# --- Base de données ---------------------------------------------------------
# Chemin relatif (résolu par rapport au projet) ou absolu
db_path=./database.sqlite3

# --- Twitch API (https://dev.twitch.tv/console) ------------------------------
twitch_client_id=YOUR_TWITCH_CLIENT_ID
twitch_client_secret=YOUR_TWITCH_CLIENT_SECRET

# --- YouTube API (https://console.cloud.google.com/) -------------------------
youtube_api_key=YOUR_YOUTUBE_API_KEY

# --- Bluesky (API publique, aucune clé requise) ------------------------------
bluesky_public_api=https://public.api.bsky.app

# --- Ollama / IA -------------------------------------------------------------
# Provider IA: ollama (local) ou openai (API compatible OpenAI: OpenRouter, OpenAI, Mistral...)
AI_PROVIDER=ollama

# Configuration Ollama (AI_PROVIDER=ollama)
ollama_host=http://localhost:11434
ollama_model=llama2

# Configuration API compatible OpenAI (AI_PROVIDER=openai)
# Ex. OpenRouter: openai_base_url=https://openrouter.ai/api/v1
openai_base_url=https://openrouter.ai/api/v1
openai_api_key=YOUR_OPENAI_API_KEY
openai_model=openai/gpt-4o-mini

# Limites de la commande /ai
ai_max_question_length=500
ai_max_response_length=1024

# --- Minigame ----------------------------------------------------------------
minigame_enabled=true

# ============================================================================
# JOURNALISATION
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=discord.log
LOG_MAX_SIZE_MB=5
LOG_BACKUP_COUNT=5

# ============================================================================
# FONCTIONNALITÉS IA
# ============================================================================
AI_ENABLED=false
AI_COMMAND_ENABLED=true
AI_MODERATION_ENABLED=true
AI_CONTENT_FILTER_ENABLED=true

# ============================================================================
# SAUVEGARDES
# ============================================================================
BACKUP_DIR=backups
MAX_BACKUPS=10

# ============================================================================
# ACTIVATION DES COGS
# true = activé, false = désactivé (défaut: true)
# ============================================================================
COG_AI_ENABLED=true
COG_COINFLIP_ENABLED=true
COG_COUNT_ENABLED=true
COG_MINIGAME_ENABLED=true
COG_MODERATION_ENABLED=true
COG_MODERATION_CONFIG_ENABLED=true
COG_MODERATION_CONTEXT_ENABLED=true
COG_PING_ENABLED=true
COG_PING_BOT_ENABLED=true
COG_STREAM_ENABLED=true
COG_USER_MODERATION_ENABLED=true
COG_XP_SYSTEM_ENABLED=true
COG_XP_VOICE_ENABLED=true
COG_YOUTUBE_ENABLED=true
COG_BLUESKY_ENABLED=true
